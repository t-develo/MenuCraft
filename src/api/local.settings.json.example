{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "",
    "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",

    "_comment_database": "Database:Provider は 'SqlServer'（既定 / Azure SQL）または 'Sqlite'（ラズパイ・ローカル）",
    "Database:Provider": "Sqlite",
    "ConnectionStrings:Default": "Data Source=menucraft.db",

    "_comment_sqlserver": "SQL Server を使う場合は上の 2 行を以下に置き換える",
    "_example_sqlserver_provider": "SqlServer",
    "_example_sqlserver_connection": "Server=tcp:<server>.database.windows.net,1433;Database=<db>;User ID=<user>;Password=<password>;Encrypt=True;",

    "_comment_jwt": "Jwt:Secret は 32 文字以上のランダム文字列。openssl rand -base64 48 などで生成すること",
    "Jwt:Secret": "",
    "Jwt:Issuer": "http://localhost:7071",
    "Jwt:Audience": "menucraft-api",
    "Jwt:AccessTokenExpirationMinutes": "60",

    "_comment_cors": "フロントエンドを別オリジンで配信する場合のみ設定（カンマ区切り）。nginx のリバースプロキシ経由なら空でよい",
    "AllowedOrigins": "http://localhost:5500",

    "_comment_seed": "初期管理者を作りたい場合のみ両方設定する。未設定なら最初に登録したユーザーが自動で Admin になる",
    "Seed:AdminEmail": "",
    "Seed:AdminPassword": ""
  }
}
