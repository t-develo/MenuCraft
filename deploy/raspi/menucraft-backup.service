[Unit]
Description=MenuCraft SQLite database backup
Documentation=https://github.com/t-develo/MenuCraft/blob/main/docs/RASPBERRY_PI.md
After=menucraft-api.service

[Service]
Type=oneshot
User=menucraft
Group=menucraft
ExecStart=/opt/menucraft/backup.sh
SyslogIdentifier=menucraft-backup

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/menucraft /var/backups/menucraft
