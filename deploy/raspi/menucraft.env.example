# MenuCraft — Raspberry Pi 実行時の環境変数
#
# 配置先: /etc/menucraft/menucraft.env  (パーミッション 600, root:menucraft)
# setup.sh がこのテンプレートを元にシークレットを自動生成して作成する。
# 手動で編集した場合は `sudo systemctl restart menucraft-api` で反映すること。
#
# Azure Functions ホストは環境変数をワーカーの IConfiguration に引き渡す。
# 階層キー (Jwt:Secret) は二重アンダースコア (Jwt__Secret) で表現する。

# --- Azure Functions ホスト ---
FUNCTIONS_WORKER_RUNTIME=dotnet-isolated
# HTTP トリガーのみのため Storage は不要。空で問題ない
AzureWebJobsStorage=
# dotnet-install.sh でのインストール先
DOTNET_ROOT=/usr/share/dotnet
# Application Insights はローカル実行では使わない
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- データベース ---
# SqlServer (既定 / Azure SQL) または Sqlite (ラズパイ)
Database__Provider=Sqlite
ConnectionStrings__Default=Data Source=/var/lib/menucraft/menucraft.db

# --- 認証 (JWT) ---
# setup.sh が openssl rand -base64 48 で生成する。手動設定する場合も 32 文字以上にすること
Jwt__Secret=__REPLACE_WITH_RANDOM_SECRET__
Jwt__Issuer=http://menucraft.local
Jwt__Audience=menucraft-api
Jwt__AccessTokenExpirationMinutes=60

# --- CORS ---
# nginx のリバースプロキシ経由で同一オリジンになるため空でよい。
# フロントエンドを別ホスト・別ポートから配信する場合のみカンマ区切りで指定する
AllowedOrigins=

# --- 初期管理者アカウント（任意） ---
# 両方を設定した場合のみ起動時に管理者を作成する。
# 未設定のままなら、最初にブラウザから登録したユーザーが自動的に Admin になる（推奨）。
# 管理者権限を失って復旧したい場合などにのみ設定する
Seed__AdminEmail=
Seed__AdminPassword=
